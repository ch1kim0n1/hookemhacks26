# Frontend runtime config. Copy to .env.local for local overrides.
VITE_WS_URL=ws://127.0.0.1:8081/ws
VITE_API_BASE=http://127.0.0.1:8080
# Set to "true" to enable Demo Safe Mode (reduced animation, clamped graph).
VITE_SENTINEL_DEMO_SAFE=false
# Optional: full URL encoded into the /demo QR tile (defaults to origin + /#/bench).
# VITE_DEMO_QR_URL=https://example.com/my-writeup
