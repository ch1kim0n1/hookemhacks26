{
    "name": "@sentinel/mempool-monitor",
    "version": "0.1.0-phase1",
    "private": true,
    "description": "Watches the Anvil mempool and publishes raw tx events. Phase 2 implementation.",
    "main": "src/index.ts",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@sentinel/logger": "workspace:^",
        "@sentinel/stream-client": "workspace:*",
        "ethers": "6.11.1",
        "fastify": "4.26.2",
        "ioredis": "5.3.2",
        "pino-pretty": "10.3.1",
        "prom-client": "^15.1.3",
        "viem": "2.8.13",
        "ws": "8.16.0",
        "zod": "3.22.4"
    },
    "devDependencies": {
        "@types/node": "20.11.24",
        "@types/ws": "8.5.10",
        "tsx": "4.7.1",
        "typescript": "5.3.3",
        "vitest": "1.4.0"
    }
}
