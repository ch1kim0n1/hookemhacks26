{
    "name": "sentinel-v2",
    "version": "0.1.0-phase1",
    "private": true,
    "description": "SENTINEL v2 — Autonomous Threat Intelligence Protocol (monorepo)",
    "license": "MIT",
    "packageManager": "pnpm@8.15.4",
    "engines": {
        "node": ">=20.11.1",
        "pnpm": ">=8.15.4"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "test": "turbo run test",
        "lint": "biome ci .",
        "lint:biome": "biome check .",
        "format": "biome check --write .",
        "typecheck": "turbo run typecheck",
        "contracts:build": "cd contracts && forge build",
        "contracts:test": "cd contracts && forge test",
        "bootstrap": "bash ./scripts/bootstrap.sh",
        "demo:ready": "bash ./scripts/demo-ready.sh",
        "verify:timings": "node ./scripts/verify-timings-sync.mjs",
        "verify:streams": "node ./scripts/verify-redis-streams.mjs",
        "verify:addresses": "node ./scripts/verify-addresses.mjs",
        "verify:addresses:file": "SKIP_RPC_CHECK=1 node ./scripts/verify-addresses.mjs",
        "validate:schemas": "node ./scripts/validate-schemas.mjs",
        "verify": "node ./scripts/verify-timings-sync.mjs && node ./scripts/verify-redis-streams.mjs && node ./scripts/verify-demo-scripts.mjs && SKIP_RPC_CHECK=1 node ./scripts/verify-addresses.mjs && node ./scripts/validate-schemas.mjs",
        "test:python": "bash ./scripts/run-python-tests.sh"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@evilmartians/lefthook": "1.10.10",
        "turbo": "1.13.0",
        "typescript": "5.3.3"
    }
}
