{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "PendingTxEvent",
    "type": "object",
    "required": ["schema", "observedAt", "tx"],
    "properties": {
        "schema": { "const": "PendingTxEvent@1" },
        "observedAt": { "type": "string", "format": "date-time" },
        "tx": {
            "type": "object",
            "required": ["hash", "from", "to"],
            "properties": {
                "hash": { "type": "string" },
                "from": { "type": "string" },
                "to": { "type": "string" },
                "value": { "type": "string" },
                "gasPrice": { "type": "string" },
                "gasLimit": { "type": "string" },
                "nonce": { "type": "number" },
                "selector": { "type": "string" },
                "decodedArgs": {},
                "isFlashLoanOrigin": { "type": "boolean" },
                "involvesProtectedProtocol": { "type": "boolean" },
                "callGraphDepth": { "type": "number" },
                "timestamp": { "type": "number" }
            }
        }
    }
}
