{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "ThreatConfirmedEvent",
    "type": "object",
    "required": [
        "schema",
        "eventId",
        "confidence",
        "pattern",
        "attackerAddresses",
        "victimProtocol",
        "triggeringTxHashes",
        "observedAtBlock",
        "timestamp"
    ],
    "properties": {
        "schema": { "const": "ThreatConfirmedEvent@1" },
        "eventId": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 10000 },
        "pattern": { "type": "string" },
        "attackerAddresses": {
            "type": "array",
            "items": { "type": "string" }
        },
        "victimProtocol": { "type": "string" },
        "triggeringTxHashes": {
            "type": "array",
            "items": { "type": "string" }
        },
        "observedAtBlock": { "type": "number" },
        "timestamp": { "type": "string" },
        "observations": { "type": "number" },
        "note": { "type": "string" }
    }
}
