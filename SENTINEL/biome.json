{
    "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignore": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.turbo/**",
            "**/contracts/lib/**",
            "**/contracts/out/**",
            "**/zk/target/**",
            "pnpm-lock.yaml",
            "**/*.sol",
            "absolute-docs/**",
            "**/bench/results/**",
            "**/public/bench/**"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": false,
        "rules": {
            "recommended": true,
            "a11y": {
                "noSvgWithoutTitle": "off"
            },
            "complexity": {
                "noBannedTypes": "off"
            },
            "style": {
                "noNonNullAssertion": "off"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "noArrayIndexKey": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always"
        }
    }
}
