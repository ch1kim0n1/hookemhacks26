# =============================================================================
# ClawGuard — Environment Configuration
# =============================================================================
# Copy to `.env` (gitignored) and fill in. Never commit real keys.
# Required groupings and deploy workflow documented in docs/BASE_SEPOLIA.md.
# =============================================================================

# --- Required: LLM backend ---------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...                     # optional — enables gpt-4o-mini LLM judge

# --- Required: Chain (Base Sepolia, chain id 84532) --------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CLAWGUARD_PRIVATE_KEY=0x...your-private-key

# Deployed contract addresses. Populate these by running:
#   cd contracts && forge script script/DeployAll.s.sol --broadcast --rpc-url $BASE_SEPOLIA_RPC_URL
#   python scripts/verify_base_sepolia.py
CLAWGUARD_REGISTRY_ADDRESS=0x...
DEFENSE_PROTOCOL_ADDRESS=0x...
CONSENSUS_VOTING_ADDRESS=0x...
PAUSE_CONTROLLER_ADDRESS=0x...
VICTIM_LENDING_POOL_ADDRESS=0x...

# Alternate address source (overrides individual vars above).
# Useful for multi-env configs. File format: JSON { "Name": "0x..." }.
# ADDRESSES_FILE=config/addresses.base-sepolia.json

# --- ZK prover ---------------------------------------------------------------
# real | mock | auto   (auto = real if binary present, else mock)
CLAWGUARD_ZK_MODE=auto
# Warm the prover at startup so first production request isn't cold.
CLAWGUARD_ZK_PREWARM=1
# Silence the "you are using the mock prover" warning in dev/demo.
# Leave UNSET in production so the warning is loud.
# CLAWGUARD_ACK_MOCK_PROVER=1
# Allow publishing defense updates without a ZK proof (dev only).
# ALLOW_EMPTY_ZK_PROOF=0

# --- Network (defense propagation) -------------------------------------------
# Other ClawGuard nodes to fan out defense updates to. Comma-separated URLs.
# CLAWGUARD_PEER_URLS=https://peer-a.example,https://peer-b.example
# CLAWGUARD_POLL_INTERVAL_SEC=10
# SKIP_ZK_PROOF=false                      # applier-side: skip remote proof verify

# --- API / dashboard ---------------------------------------------------------
# CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# API_RATE_LIMIT_PER_MIN=100
# MAX_UPLOAD_BYTES=10485760
# API_HANDLER_TIMEOUT_SEC=30
# CLAWGUARD_HOOK_TIMEOUT_SEC=3.0
# API_BEARER_TOKEN=                         # required for /ws/updates + /metrics
# METRICS_BEARER_TOKEN=                     # separate token for Prometheus scrape

# --- Observability -----------------------------------------------------------
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# OTEL_EXPORTER_OTLP_ENDPOINT=
# LOG_LEVEL=INFO

# --- Demo / paper trading (optional) -----------------------------------------
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=

# --- Contract verification (optional) ---------------------------------------
# BASESCAN_API_KEY=

# --- Whisper (optional: auto-downloads model on first use) -------------------
# No key needed; install with:  uv pip install openai-whisper

# =============================================================================
# See docs/BASE_SEPOLIA.md for:
#   1. Full deploy sequence (forge → verify → populate .env)
#   2. Manual E2E checks (publishAttack / isKnownAttack / publishDefenseUpdate)
#   3. Two-node demo setup (Node Alpha / Node Beta)
# =============================================================================
