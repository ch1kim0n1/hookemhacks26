# === Required ===
ANTHROPIC_API_KEY=sk-ant-...

# === On-chain registry (Base Sepolia) ===
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CLAWGUARD_PRIVATE_KEY=0x...your-private-key
CLAWGUARD_REGISTRY_ADDRESS=0x...deployed-contract-address

# Defense stack (Phase 1 contracts — set after forge deploy)
# DEFENSE_PROTOCOL_ADDRESS=0x...
# CONSENSUS_VOTING_ADDRESS=0x...
# PAUSE_CONTROLLER_ADDRESS=0x...
# VICTIM_LENDING_POOL_ADDRESS=0x...

# === Optional: Alpaca paper trading (for demo) ===
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# === Optional: Contract verification ===
BASESCAN_API_KEY=

# === Optional: Whisper audio (auto-downloads model) ===
# No key needed, just install: uv pip install openai-whisper

# === API / dashboard (skill/api.py) ===
# CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# API_RATE_LIMIT_PER_MIN=100
# MAX_UPLOAD_BYTES=10485760
# API_HANDLER_TIMEOUT_SEC=30
# CLAWGUARD_HOOK_TIMEOUT_SEC=3.0

